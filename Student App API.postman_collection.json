            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. Student Stats",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response body contains expected statistical fields\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"total_students\");\r",
              "    pm.expect(jsonData).to.have.property(\"average_marks\");\r",
              "    pm.expect(jsonData.average_marks).to.be.a(\"number\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/students/stats/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "students",
            "stats",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "5. Deactivate Student",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// [Pre-req Script] Executed BEFORE sending the request\r",
              "var token = pm.environment.get(\"token\");\r",
              "if (!token) {\r",
              "    console.warn(\"Warning: No token found in environment. Request might return 401.\");\r",
              "}"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// [Post-req Script] Executed AFTER response is received\r",
              "pm.test(\"Student deactivated successfully\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData).to.have.property(\"status\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/students/1/deactivate/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "students",
            "1",
            "deactivate",
            ""
          ]
        }
      },
      "response": []
    }

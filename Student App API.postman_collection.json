      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"name\": \"Software Engineering\",\r\n  \"code\": \"CS301\",\r\n  \"description\": \"Core SE principles and patterns\"\r\n}",
          "options": {
